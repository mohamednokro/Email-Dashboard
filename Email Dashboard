        "import smtplib, imaplib, ssl, email\n",
        "from email import policy\n",
        "from email.message import EmailMessage\n",
        "from getpass import getpass\n",
        "import pandas as pd\n",
        "import plotly.express as px\n",
        "from dash import Dash, html, dcc, dash_table, Input, Output, State\n",
        "import dash_bootstrap_components as dbc\n",
        "\n",
        "DEMO = True\n",
        "EMAIL = 'demo@example.com' if DEMO else input('Adresse Gmail : ')\n",
        "PASSWORD = '' if DEMO else getpass('Mot de passe application : ')\n",
        "SENT_FOLDER = '\"[Gmail]/Sent Mail\"'  # Adapter selon la langue du compte\n",
        "COLS = ['Expediteur', 'Destinataire', 'Sujet', 'Date', 'Type', 'Non_lu']\n",
        "messages_demo = [dict(zip(COLS, ['prof@example.com', EMAIL, sujet, (pd.Timestamp.now(tz='UTC')-pd.Timedelta(hours=i*7)).isoformat(), 'Entrant' if i%3 else 'Sortant', i%3 != 0])) for i,sujet in enumerate(['Projet Python','Urgent : réunion','Facture','Travail en groupe','Promotion','TD Python','Paiement','Projet Cloud','Bonjour'])]\n"
