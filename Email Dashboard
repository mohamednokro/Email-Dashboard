      "source": [
        "def receive_emails(folder, direction):\n",
        "    with imaplib.IMAP4_SSL('imap.gmail.com') as mail:\n",
        "        mail.login(EMAIL, PASSWORD)\n",
        "        if mail.select(folder, readonly=True)[0] != 'OK':\n",
        "            raise ValueError('Dossier introuvable : '+folder)\n",
        "        status, data = mail.search(None, 'ALL')\n",
        "        if status != 'OK':\n",
        "            raise RuntimeError('Recherche impossible')\n",
        "        result = []\n",
        "        for num in data[0].split()[-100:]:\n",
        "            status, parts = mail.fetch(num, '(BODY.PEEK[HEADER] FLAGS)')\n",
        "            if status != 'OK':\n",
        "                continue\n",
        "            for part in parts:\n",
        "                if isinstance(part, tuple):\n",
        "                    msg = email.message_from_bytes(part[1], policy=policy.default)\n",
        "                    result.append(dict(zip(COLS, [str(msg.get('From','')), str(msg.get('To','')), str(msg.get('Subject','')), str(msg.get('Date','')), direction, b'\\\\Seen' not in part[0]])))\n",
        "        return result\n",
        "\n",
        "def load_emails():\n",
        "    rows = messages_demo if DEMO else receive_emails('INBOX','Entrant') + receive_emails(SENT_FOLDER,'Sortant')\n",
        "    df = pd.DataFrame(rows, columns=COLS)\n",
        "    df['Date'] = pd.to_datetime(df['Date'], errors='coerce', utc=True, format='mixed')\n",
        "    return df\n"
      ]
    },
