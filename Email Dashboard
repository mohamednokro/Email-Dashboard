        "def classification(sujet):\n",
        "    sujet = str(sujet).lower()\n",
        "    for mots, categorie in [(['urgent','alerte'],'Urgent'),(['facture','paiement'],'Factures'),(['projet','travail'],'Professionnel'),(['promotion','publicité'],'Spam potentiel')]:\n",
        "        if any(m in sujet for m in mots):\n",
        "            return categorie\n",
        "    return 'Autres'\n",
        "\n",
        "def graphique_classification(df):\n",
        "    stats = df['Sujet'].apply(classification).value_counts().rename_axis('Categorie').reset_index(name='Nombre')\n",
        "    return px.pie(stats,names='Categorie',values='Nombre',hole=.4,title='Classification')\n"
      ]
    },
