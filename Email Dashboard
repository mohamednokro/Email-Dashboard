        "def graphique_emails(df, periode):\n",
        "    df = df.dropna(subset=['Date']).copy()\n",
        "    df['Periode'] = df['Date'].dt.strftime('%Y-%m-%d' if periode=='day' else '%Y-%m-%d %H:00')\n",
        "    stats = df.groupby(['Periode','Type']).size().reset_index(name='Nombre')\n",
        "    return px.bar(stats,x='Periode',y='Nombre',color='Type',barmode='group',title='Activité des emails (UTC)',template='plotly_white')\n"
      ]
    },
