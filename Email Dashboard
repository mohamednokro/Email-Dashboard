        "@app.callback(Output('data','data'),Output('refresh-status','children'),Input('refresh','n_clicks'))\n",
        "def refresh(n):\n",
        "    try:\n",
        "        df = load_emails()\n",
        "        df['Date'] = df['Date'].astype(str)\n",
        "        return df.to_dict('records'),'Emails actualisés'\n",
        "    except Exception as e:\n",
        "        return [],f'Erreur : {e}'\n",
        "\n",
        "@app.callback(Output('entrants','children'),Output('sortants','children'),Output('urgents','children'),Output('activity','figure'),Output('categories','figure'),Output('last','data'),Input('data','data'),Input('periode','value'))\n",
        "def update(data,periode):\n",
        "    df = pd.DataFrame(data or [],columns=COLS)\n",
        "    df['Date'] = pd.to_datetime(df['Date'],errors='coerce',utc=True,format='mixed')\n",
        "    last = last_5_emails(df).copy()\n",
        "    last['Date'] = last['Date'].astype(str)\n",
        "    return int((df['Type']=='Entrant').sum()),int((df['Type']=='Sortant').sum()),int(((df['Type']=='Entrant') & (df['Non_lu']==True) & (df['Sujet'].apply(classification)=='Urgent')).sum()),graphique_emails(df,periode),graphique_classification(df),last.to_dict('records')\n",
        "\n",
        "@app.callback(Output('send-status','children'),Input('send','n_clicks'),State('dest','value'),State('subject','value'),State('message','value'),prevent_initial_call=True)\n",
        "def envoyer(n,dest,sujet,message):\n",
        "    if not dest or '@' not in dest or not sujet or not message:\n",
        "        return 'Remplissez tous les champs correctement.'\n",
        "    try:\n",
        "        return send_email(dest,sujet,message)+' — cliquez sur Actualiser.'\n",
        "    except Exception as e:\n",
        "        return f'Erreur : {e}'\n",
        "\n",
        "@app.callback(Output('alert-status','children'),Input('alert','n_clicks'),State('data','data'),prevent_initial_call=True)\n",
        "def alerte(n,data):\n",
        "    try:\n",
        "        return alert_system(pd.DataFrame(data or [],columns=COLS))\n",
        "    except Exception as e:\n",
        "        return f'Erreur : {e}'\n"
